# ===========================================
# ML Task Scheduler - Root Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets!

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=task_scheduler

# Security (REQUIRED - Change in production!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production

# App URLs
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional locally, required for Google sign-in)
# Google Cloud project: ml-task-schedule (988268829955)
# Cloud Hub: https://console.cloud.google.com/cloud-hub/home?project=ml-task-schedule
# Project settings: https://console.cloud.google.com/home/dashboard?project=ml-task-schedule
GOOGLE_CLIENT_ID=988268829955-5eg73ov4qp20uuqdsnr64t9fd84hc8tn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Environment
NODE_ENV=development
FLASK_ENV=development

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@task-scheduler.com
