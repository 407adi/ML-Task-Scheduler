# =================================
# ML Task Scheduler - Frontend Environment
# =================================
# Copy this file to .env and update values as needed
# NEVER commit .env files with real values!

# API Backend URL
VITE_API_URL=http://localhost:3001

# Google login redirects to: ${VITE_API_URL}/api/v1/auth/google
# Ensure this points to the backend that serves auth routes.
# Google OAuth Client ID from Google Cloud project ml-task-schedule (988268829955)
VITE_GOOGLE_CLIENT_ID=988268829955-5eg73ov4qp20uuqdsnr64t9fd84hc8tn.apps.googleusercontent.com

# WebSocket URL (usually same as API URL)
VITE_WS_URL=http://localhost:3001

# Environment (development | staging | production)
VITE_ENV=development
